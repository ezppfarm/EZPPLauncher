{
  "name": "ezpplauncher",
  "version": "1.1.4",
  "main": "app.js",
  "license": "MIT",
  "author": "HorizonCode",
  "build": {
    "appId": "farm.ezpp.ezppfarm.launcher",
    "productName": "ezpplauncher",
    "directories": {
      "output": "release",
      "buildResources": "dist"
    },
    "asar": true,
    "win": {
      "icon": "./assets/logo.png",
      "target": [
        "portable"
      ]
    },
    "nsis": {
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "EZPPLauncher.exe"
    }
  },
  "frontend": {
    "config": {
      "applicationName": "EZPPLauncher"
    }
  },
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w get-window-by-name",
    "pack-win": "electron-builder --win --x64",
    "pack-linux": "electron-builder --linux --x64",
    "pack-mac": "electron-builder --mac --x64",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^24.2.0",
    "electron-builder": "^23.6.0",
    "electron-packager": "^17.1.1",
    "electron-rebuild": "^3.2.9"
  },
  "dependencies": {
    "axios": "^0.27.2",
    "compare-versions": "^6.0.0-rc.1",
    "custom-electron-titlebar": "^4.1.1",
    "discord-auto-rpc": "^1.0.17",
    "discord-rpc": "^4.0.1",
    "get-window-by-name": "^2.0.0",
    "jquery": "^3.6.0",
    "node-downloader-helper": "^2.1.4",
    "qiao-regedit": "^0.1.5",
    "sweetalert2": "^11.5.2"
  }
}
